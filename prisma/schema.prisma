// Switchboard Platform — Prisma schema
// Provider is `sqlite` because Turso/libSQL is SQLite-compatible; the runtime
// connects through @prisma/adapter-libsql (see lib/db.ts) which works against
// both a local `file:` url (dev) and a remote `libsql://` Turso url (prod).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (better-auth managed tables). User carries our domain fields too.
// ---------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  isAdmin       Boolean  @default(false) // also enforced via ADMIN_EMAILS env
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shops    Shop[]
  sessions Session[]
  accounts Account[]
  devices  DeviceToken[]
}

// ---------------------------------------------------------------------------
// Owner mobile app (Phase 0). Auth is a parallel, token-based path for native
// clients (better-auth's cookie sessions don't fit native): an email-OTP login
// (MobileAuthCode) exchanges for a long-lived, revocable device credential
// (DeviceToken). The bearer token sent by the app is an HMAC over the device id
// (lib/mobileAuth), so it can't be forged, and deleting the row revokes it.
// ---------------------------------------------------------------------------
model DeviceToken {
  id         String   @id @default(cuid()) // == the device id embedded in the bearer token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken  String? // Expo push token (ExponentPushToken[...]) for notifications
  platform   String? // ios | android
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([pushToken])
}

model MobileAuthCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String // sha256 of the 6-digit code — never stored in the clear
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------
model Shop {
  id           String  @id @default(cuid()) // == client_id everywhere
  ownerId      String
  owner        User    @relation(fields: [ownerId], references: [id])
  businessName String
  vertical     String // auto | hvac | home_services
  city         String?
  timezone     String?
  websiteUrl   String?
  businessNumber String? // their existing published line
  ownerMobile  String? // alerts
  status       String  @default("onboarding") // onboarding | live | paused | canceled

  // billing
  stripeCustomerId String?
  stripeSubId      String?
  plan             String? // catch | front_desk | growth
  subStatus        String? // trialing | active | past_due | canceled

  // provisioned resources (non-secret IDs only)
  agentProvider  String? // retell | vapi
  agentId        String?
  agentNumber    String? // the AI's phone number
  twilioNumberSid String?
  calEventTypeMap Json? // LEGACY (pre-owned-scheduling Cal.com event-type map); unused — availability is now computed from config hours + own Booking rows
  a2pBrandSid    String?
  a2pCampaignSid String?
  a2pMessagingServiceSid String?
  a2pStatus      String? // not_started | submitted | approved | failed
  smsConsentAt   DateTime? // owner agreed to receive automated texts (A2P wall)
  smsOptOut      Boolean @default(false) // owner replied STOP to the agent number
  liveVersionId  String?
  ingestSecret   String? // per-shop secret for the call-ingest endpoint
  digestOptOut   Boolean @default(false) // owner unsubscribed from the weekly digest

  createdAt DateTime @default(now())

  versions AgentVersion[]
  run      OnboardingRun?
  calls    CallRecord[]
  bookings Booking[]
  auditLogs AuditLog[]
  customers Customer[]
  followUpRules FollowUpRule[]
}

// Appointments we own. Switchboard computes availability from the shop's hours
// minus THIS shop's own bookings — so shops never collide on a shared calendar
// (the old single-Cal.com-user model let shop A's booking block shop B at the
// same clock-time). Each row is a fixed-length slot; times are stored as UTC
// instants (startUtc/endUtc) and rendered in the shop's timezone.
model Booking {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  startUtc      DateTime
  endUtc        DateTime
  service       String?
  customerName  String?
  customerPhone String?
  status        String   @default("confirmed") // confirmed | completed | canceled | no_show
  source        String   @default("agent") // agent | manual
  callId        String? // the call that created it, if any
  createdAt     DateTime @default(now())

  // Customer layer. Nullable: a booking whose phone can't be normalized to E.164
  // (blocked/withheld caller ID) stays unlinked rather than being forced onto a
  // wrong customer. See lib/customer.ts.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  assetId    String?
  asset      CustomerAsset? @relation(fields: [assetId], references: [id])
  // ACTUAL job value in CENTS, once the work is done — distinct from the
  // *estimated* CallRecord.estJobValue (whole dollars, from the AI's post-call
  // analysis). All new money fields are cents; lib/customer.ts owns the one
  // conversion at that boundary.
  valueCents Int?

  @@index([shopId, startUtc])
  @@index([customerId])
}

model AgentVersion {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  config       Json // structured business config (no secrets)
  systemPrompt String
  qaVerdict    String? // go | no_go
  qaFlags      Json? // [{risk, fix}]
  status       String   @default("draft") // draft | approved | live | archived
  createdAt    DateTime @default(now())
}

model OnboardingRun {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id])
  status      String   @default("in_progress") // in_progress | waiting_user | live | failed
  currentStep String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  steps       ProvisioningStep[]
}

model ProvisioningStep {
  id       String        @id @default(cuid())
  runId    String
  run      OnboardingRun @relation(fields: [runId], references: [id])
  key      String // see pipeline table
  type     String // auto | user
  status   String        @default("pending") // pending | running | done | waiting_user | failed | skipped
  result   Json? // external IDs, logs, error message, task payload
  attempts Int           @default(0)
  updatedAt DateTime     @updatedAt

  @@unique([runId, key])
}

model CallRecord {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  callId        String   @unique
  timestamp     DateTime
  afterHours    Boolean  @default(false)
  durationSec   Int      @default(0)
  callerPhone   String?
  intent        String?
  outcome       String? // booked | message | escalated | missed_recovered | no_action
  booked        Boolean  @default(false)
  service       String?
  apptTime      String?
  estJobValue   Int      @default(0)
  hotJob        Boolean  @default(false)
  recovered     Boolean  @default(false)
  transcriptUrl String? // Retell recording_url (audio), not the transcript text
  summary       String? // short post-call summary from the voice provider
  transcript    String? // full transcript text
  handledAt     DateTime? // owner marked this call's follow-up as done (mobile app)
  flags         Json?

  // Customer layer. Nullable — anonymous calls (blocked caller ID, or a number
  // toE164 can't confidently normalize) are real data and stay unlinked.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, timestamp])
}

// ---------------------------------------------------------------------------
// Customer layer (CRM). See docs/CRM-PLAN.md.
//
// The rest of the schema is event-shaped: CallRecord and Booking are flat rows
// hanging off a Shop, with no entity representing the person on the other end
// of the phone. Customer is that entity — the spine the relationship data hangs
// off, so two calls six months apart are one customer instead of two rows.
// ---------------------------------------------------------------------------
model Customer {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  displayName String? // best-known name; what the agent and owner see
  firstName   String?
  lastName    String?
  email       String?
  addressLine String?
  city        String?
  postalCode  String?
  notes       String? // freeform owner notes

  stage  String @default("lead") // lead | active | dormant | lost
  source String @default("agent") // agent | manual | import

  // Customer-directed messaging consent. Deliberately SEPARATE from
  // Shop.smsConsentAt/smsOptOut, which govern texting the *owner* (who signed
  // up). Texting a shop's customers is a different legal posture and likely a
  // different A2P campaign — see docs/CRM-PLAN.md §5 before sending anything.
  smsConsentAt DateTime?
  smsOptOut    Boolean   @default(false)
  doNotContact Boolean   @default(false)

  // Denormalized rollups — recomputed on write inside the triggering
  // transaction, plus a nightly reconciliation job that repairs drift.
  firstSeenAt   DateTime @default(now())
  lastContactAt DateTime @default(now())
  callCount     Int      @default(0)
  bookingCount  Int      @default(0)
  noShowCount   Int      @default(0)
  lifetimeValue Int      @default(0) // CENTS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phones    CustomerPhone[]
  assets    CustomerAsset[]
  tags      CustomerTag[]
  events    CustomerEvent[]
  calls     CallRecord[]
  bookings  Booking[]
  followUps FollowUpTask[]

  @@index([shopId, lastContactAt])
  @@index([shopId, stage])
}

// Identity resolution. A child table rather than a `phone` column on Customer
// because shops routinely have one customer calling from a cell, a work line,
// and a spouse's phone — and because @@unique([shopId, phoneE164]) lets ingest
// resolve by upsert instead of read-then-write, which is what makes the
// mid-call create_booking path and the post-call webhook converge on the same
// row no matter which lands first.
model CustomerPhone {
  id         String   @id @default(cuid())
  shopId     String // denormalized so the unique index is tenant-scoped
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phoneE164  String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([shopId, phoneE164])
  @@index([customerId])
}

// The thing being serviced. Verticals differ (vehicle / property / equipment)
// but the shape doesn't, so this is one polymorphic table rather than six
// vertical-specific ones.
model CustomerAsset {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // vehicle | property | equipment
  label      String // "2018 Silverado" | "412 Oak St" | "Carrier 3-ton"
  attrs      Json? // { year, make, model, vin, plate } | { sqft, systemType, installedYear }
  createdAt  DateTime @default(now())

  bookings Booking[]

  @@index([customerId])
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String

  @@unique([customerId, label])
  @@index([label])
}

// The non-call, non-booking half of the timeline. Calls and bookings already
// have their own tables and are unioned in at read time (no write
// amplification, no sync bugs); this holds only what has no home today.
model CustomerEvent {
  id         String   @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // note | stage_change | tag | sms_sent | email_sent | followup_done | merged
  body       String?
  detail     Json?
  actorId    String? // user id, or null for system
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// Follow-up engine (Phase D). Schema lands now so the customer layer is
// complete; the send path is gated on A2P — see docs/CRM-PLAN.md §5.
model FollowUpRule {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id])
  trigger    String // call_unbooked | booking_completed | no_show | dormant
  delayHours Int
  channel    String // sms | email | task
  template   String // supports {{firstName}}, {{service}}, {{shopName}}
  enabled    Boolean  @default(false) // OFF by default; owner opts in per rule
  createdAt  DateTime @default(now())

  @@index([shopId, trigger])
}

model FollowUpTask {
  id         String    @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ruleId     String?
  callId     String?
  dueAt      DateTime
  channel    String // sms | email | task
  body       String
  status     String    @default("pending") // pending | sent | done | skipped | failed
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([shopId, status, dueAt])
  @@index([customerId])
}

model WebhookEvent {
  id        String   @id // provider event id (stripe evt_..., etc.)
  provider  String
  createdAt DateTime @default(now())
}

// Captured errors / operational failures — the in-app observability feed.
// Written by lib/observability.reportError() from the onRequestError hook,
// provisioning failures, webhooks and jobs. Independent of Shop so shopless
// (infra) errors are still recorded.
model FailureEvent {
  id        String   @id @default(cuid())
  source    String // request | provisioning | webhook | job | manual
  level     String   @default("error") // error | warn
  message   String
  route     String? // request path or route file
  shopId    String? // optional correlation (no FK — errors outlive shops)
  digest    String? // Next error digest / dedupe hint
  detail    Json? // stack + context
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit log of owner-initiated changes (who/what/when) — Phase 3 hardening.
model AuditLog {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  actorId   String? // user id, or null for system
  action    String // e.g. "wizard.completed", "version.published", "shop.paused"
  detail    Json?
  createdAt DateTime @default(now())
}
